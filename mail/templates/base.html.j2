{% set c = {
  'red':      '#c8202f',
  'red_dark': '#9e1b27',
  'white':    '#fffdf8',
  'bg':       '#f7f3ec',
  'card':     '#fffdf9',
  'text':     '#4a1a1f',
} %}

<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light only">
</head>
<body style="margin:0;background-color:{{ c.bg }};font-family:Arial,Helvetica,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" bgcolor="{{ c.bg }}">
    <tr><td align="center" style="padding:24px;">
      <table role="presentation" width="560" cellpadding="0" cellspacing="0" bgcolor="{{ c.card }}" style="max-width:100%;background-color:{{ c.card }};border-radius:8px;">
        <tr><td align="center" bgcolor="{{ c.red }}" style="padding:22px;border-radius:8px 8px 0 0;background-color:{{ c.red }};background-image:repeating-linear-gradient(45deg,{{ c.red }} 0,{{ c.red }} 14.14px,{{ c.white }} 14.14px,{{ c.white }} 28.28px);">
          <span style="display:inline-block;background-color:{{ c.red_dark }};color:{{ c.white }}; padding:8px 20px;border-radius:6px;font-size:22px;font-weight:bold;">
            {{ title }}
          </span>
        </td></tr>
        <tr><td style="padding:24px;color:{{ c.text }};font-size:16px;line-height:1.5;">
          {% block content %}{% endblock %}
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>